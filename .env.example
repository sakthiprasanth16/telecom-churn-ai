# Copy this file to ".env" (same folder) and fill in your real values.
# .env is gitignored and must NEVER be committed. This .env.example file
# contains placeholders only and is safe to commit.

# MongoDB Atlas connection string.
# Get this from: Atlas dashboard -> Database -> Connect -> Drivers -> Python
# Replace <username>, <password>, and <cluster-url> with your real values.
# IMPORTANT: if your password contains special characters (@, :, /, etc.),
# they must be URL-encoded or the connection string will fail to parse.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/?retryWrites=true&w=majority

# Database name to use within your Atlas cluster. This will be created
# automatically on first write if it doesn't already exist.
MONGODB_DB_NAME=telecom_churn

# How long (ms) to wait for MongoDB to respond before giving up and running
# in degraded mode (predictions still work, just aren't logged).
MONGODB_TIMEOUT_MS=5000
